# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Django core
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL for production, omit for SQLite in local dev)
# DATABASE_URL=postgres://cookinbook:cookinbook@localhost:5432/cookinbook

# AI integration
GEMINI_API_KEY=your-gemini-api-key-here

# Elasticsearch
# ELASTICSEARCH_HOST=https://localhost:9200
# ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password-here
ELASTICSEARCH_CERT=

# UCP integration (if applicable)
UCP_MOCK_MODE=True
UCP_API_KEY=
UCP_SECRET=

# Docker Compose (used by docker-compose.yml)
POSTGRES_PASSWORD=cookinbook
